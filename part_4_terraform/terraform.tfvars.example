# Terraform variables file
# Copy this to terraform.tfvars and customize for your environment

aws_region     = "us-east-1"
environment    = "dev"
s3_bucket_name = "rearc-quest-data"
lambda_timeout = 300
lambda_memory  = 512

tags = {
  Project     = "rearc-quest"
  Environment = "dev"
  ManagedBy   = "Terraform"
  Owner       = "YourName"
}
